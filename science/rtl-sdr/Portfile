PortSystem          1.0
PortGroup           cmake 1.1
PortGroup           github 1.0

name                rtl-sdr

github.setup        osmocom rtl-sdr 2.0.2 v
github.tarball_from archive
revision            0
epoch               1
checksums           rmd160  7aac7ef6cb24229d6774367a6e6c45e52a0bbbe9 \
                    sha256  d69943eb32df742bc38a00ce6615e41250fd57851174e5ff916ec31e9e9e68e9 \
                    size    136512
revision            0
categories          science comms
license             GPL-2+
maintainers         {michaelld @michaelld} openmaintainer
description         ${name} allows using devices with a RTL2832U chipset as software defined radio (SDR)
long_description    ${description}
homepage            http://sdr.osmocom.org/trac/wiki/rtl-sdr

depends_build-append port:pkgconfig path:bin/doxygen:doxygen
depends_lib-append   path:lib/pkgconfig/libusb-1.0.pc:libusb

# remove top-level library and includes paths, such that internal
# libraries and headers are used instead of any already-installed ones.

configure.ldflags-delete -L${prefix}/lib
configure.cppflags-delete -I${prefix}/include

# rtl-sdr cmake doesn't understand build type "MacPorts";
# use release unless +debug is set

if {[variant_isset debug]} {
    cmake.build_type Debug
} else {
    cmake.build_type Release
}

variant rtlsdrblog description {Use RTL-SDR Blog Driver for V4 dongles} {
    github.setup    rtlsdrblog rtl-sdr-blog aed0ea19f3a273370a13c9009b96313c75d54c7b
    version         20260322-[string range ${github.version} 0 7]
    checksums       rmd160  932dc3242f6dfe01d47de50c289aa8d13ae5c6d5 \
                    sha256  53d070b234507bd0eaa25ee2ec7b4e69d93a038ccf970c1390ad84162d3da5e1 \
                    size    138562
    homepage        https://github.com/rtlsdrblog/rtl-sdr-blog

    patch.pre_args  -p1
    patchfiles      patch-fix-git-describe.diff

    configure.compiler \
                    macports-gcc-15
}
